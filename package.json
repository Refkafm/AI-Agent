{
  "name": "astra-workspace",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/domain.test.ts src/lib/server/*.test.ts",
    "doctor": "node scripts/doctor.mjs",
    "verify": "npm test && npm run typecheck && npm run build",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "@react-three/fiber": "^9.4.0",
    "@react-three/drei": "^10.7.0",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "playwright": "^1.56.0"
  },
  "type": "module"
}
